{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "wm",
        "terminal",
        {
            "type": "command",
            "key": "CPU",
            "text": "lscpu | awk -F: '/Model name/ { match($2,/i[3579]-[0-9A-Za-z]+/); print substr($2,RSTART,RLENGTH) }'"
        },
        "gpu",
        "memory",
        "swap",
        "disk",
        "localip",
        "battery",
        "locale",
        "colors"
    ]
}